# Rust build output.
/target/

# The robustness corpus. Its bytes are fetched at run time from a manifest of
# pinned hashes, because those programs carry no licence that permits
# redistribution. The manifest is committed. The files are not.
/corpus/fetched/

# The opcode table `xtask derive-opcode-table` writes. It is calculated from
# Microsoft's VB6.OLB, a third party file the author does not own, so
# AGENTS.md bars it from this repository. The tool that produces it is
# committed instead; the table it writes is not.
derived/opcode-table.toml

# macOS.
.DS_Store

# Research tooling scratch.
.planning/research/.cache/

# Agent worktrees. Transient, and each one is a checkout of this repo.
.claude/worktrees/

# The state cache that gsd-tools writes. It is derived from ROADMAP.md and
# STATE.md, and it goes stale as soon as either one changes.
/.planning/state.json
