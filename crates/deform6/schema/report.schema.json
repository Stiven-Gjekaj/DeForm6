{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deform6:report:1",
  "title": "DeForm6 project report",
  "description": "The shape of the JSON report crates/deform6/src/report.rs serialises. Read from disk by crates/deform6/tests/schema.rs, never derived from the Rust types at run time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "defects", "limits"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportItem" }
    },
    "defects": {
      "type": "array",
      "items": { "$ref": "#/$defs/defect" }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "reportItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "confidence", "basis", "evidence"],
      "properties": {
        "path": { "type": "string" },
        "confidence": {
          "type": "string",
          "enum": ["proven", "inferred", "unrecoverable"]
        },
        "basis": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "structure", "field", "note"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "structure": { "type": "string" },
        "field": { "type": "string" },
        "note": { "type": ["string", "null"] }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "kind"],
      "properties": {
        "site": { "$ref": "#/$defs/site" },
        "kind": { "$ref": "#/$defs/defectKind" }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "rva", "structure", "field"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "rva": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4294967295
        },
        "structure": { "type": "string" },
        "field": { "type": "string" }
      }
    },
    "defectKind": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["BadMagic"],
          "properties": {
            "BadMagic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "expected", "found"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "expected": { "type": "string" },
                "found": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["OffsetOverflow"],
          "properties": {
            "OffsetOverflow": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "len"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "len": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["PastEndOfFile"],
          "properties": {
            "PastEndOfFile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "file_len"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "file_len": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ImplausibleCount"],
          "properties": {
            "ImplausibleCount": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "count", "max"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "max": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["UnmappedAddress"],
          "properties": {
            "UnmappedAddress": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "va"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "va": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["SectionOverlap"],
          "properties": {
            "SectionOverlap": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "other"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "other": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["NoNulTerminator"],
          "properties": {
            "NoNulTerminator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "limit"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "limit": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["CountMismatch"],
          "properties": {
            "CountMismatch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "count", "expected", "other_field"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "count": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "expected": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "other_field": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ModuleMarkerMismatch"],
          "properties": {
            "ModuleMarkerMismatch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "pointer", "object_type"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "pointer": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "object_type": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["UnreadablePointer"],
          "properties": {
            "UnreadablePointer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "va"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "va": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["UnknownStubShape"],
          "properties": {
            "UnknownStubShape": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "found"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "found": {
                  "type": "array",
                  "minItems": 13,
                  "maxItems": 13,
                  "items": { "type": "integer", "minimum": 0, "maximum": 255 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["EmptyName"],
          "properties": {
            "EmptyName": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["IndexHighByteSet"],
          "properties": {
            "IndexHighByteSet": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "high"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "high": { "type": "integer", "minimum": 0, "maximum": 255 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["UnrecoverableString"],
          "properties": {
            "UnrecoverableString": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "declared_len", "first_encoding", "second_encoding"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "declared_len": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "first_encoding": { "type": "string" },
                "second_encoding": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ClassNameNoDot"],
          "properties": {
            "ClassNameNoDot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["GuidLengthUnexpected"],
          "properties": {
            "GuidLengthUnexpected": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "value"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "value": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["OcxReservedFieldUnexpected"],
          "properties": {
            "OcxReservedFieldUnexpected": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "value"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["BlobLenTooSmall"],
          "properties": {
            "BlobLenTooSmall": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "blob_len"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "blob_len": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["StructureUnreadable"],
          "properties": {
            "StructureUnreadable": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "reason"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "reason": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ItemAddressUnmapped"],
          "properties": {
            "ItemAddressUnmapped": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "va"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "va": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ItemOffsetOverflow"],
          "properties": {
            "ItemOffsetOverflow": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "len"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "len": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ItemCutShort"],
          "properties": {
            "ItemCutShort": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "va", "len"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "va": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "len": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["RunsPastEnd"],
          "properties": {
            "RunsPastEnd": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "len", "end"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "len": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "end": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["UnexpectedConstant"],
          "properties": {
            "UnexpectedConstant": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "expected", "found"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "expected": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "found": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["NotAnIdentifier"],
          "properties": {
            "NotAnIdentifier": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "len"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "len": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["JumpOutOfRange"],
          "properties": {
            "JumpOutOfRange": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "va", "rel"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "va": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "rel": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["UnknownValue"],
          "properties": {
            "UnknownValue": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "value"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ItemTypeUnknown"],
          "properties": {
            "ItemTypeUnknown": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "value"],
              "properties": {
                "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
              }
            }
          }
        }
      ]
    }
  }
}
